  "meta": {
    "name": "ios18-tokens",
    "version": "0.3.0",
    "target": "iOS 18 (pre-Liquid Glass)",
    "units": "iOS points (pt). 1pt = 1 logical px in Qt. Let Qt handle devicePixelRatio.",
    "verification": {
      "VERIFIED_against_Apple_HIG": [
        "typography.scale (Large/default Dynamic Type size, incl. emphasized weights): HIG Typography page, rev. Dec 16 2025",
        "typography.tracking (SF Pro): same page",
        "color.*.systemGray .. systemGray6 (light + dark): HIG iOS gray table"
      ],
      "VERIFIED_iOS_18_6_SIMULATOR": [
        "color.light and color.dark: every captured role except unprobed rowHighlight and onTint. Alpha rounded to 3 decimals; RGB rounded to 8 bits.",
        "color.darkElevated: inherits color.dark, overriding the 6 elevated background roles. Resolved UIColor values, not blur materials.",
        "typography.uiFontLineHeight: UIFont metrics at default Large Dynamic Type. All 11 point sizes match typography.scale; HIG layout lineHeight remains separate.",
        "component: switch width/height 51/31, segmented height 32, standalone navBar/tabBar/toolbar heights 44/49/44, searchField fitting height 34. Other fields in these groups remain provisional.",
        "component.list.groupedInsetMargin: 20pt measured from 3x iPhone screenshots. Tablet geometry not inferred.",
        "motion.capturedUIKit: selected deduplicated Core Animation springs and timing curves. Not SpringBoard or SwiftUI presets. CA duration is not visible settling time."
      ],
      "NOT_PUBLISHED_BY_APPLE": [
        "Remaining component fields, spacing, radius, shadow and material have not been verified against simulator measurements.",
        "motion.duration, motion.easing and motion.spring are retained unverified estimates, not captured system transitions."
      ]
    },
    "openConflicts": [],
    "resolvedConflicts": {
      "color.dark.quaternaryLabel": "Simulator alpha 0.157 at 3-decimal export precision.",
      "color.dark.quaternaryFill": "Simulator RGB 118,118,128, alpha 0.18; original token was correct.",
      "color.dark.link": "Simulator #0984FF; original token was correct. This differs from systemBlue #0A84FF."
    },
    "captureSource": {
      "run": "https://github.com/blahajcoding/ios-reference-capture/actions/runs/43643773460",
      "systemVersion": "18.6",
      "build": "22G86",
      "device": "iPhone 16, 393x852pt, 3x",
      "appearance": "normal contrast, light/dark base and dark elevated",
      "report": "ios-reference-capture/REFERENCE.md"
    },
    "howToGetExactValues": "Apple warns documented values may fluctuate between releases. For true 1:1, dump resolved UIColor values from an iOS 18 simulator and measure components from Apple Design Resources (Figma/Sketch iOS 18 kit).",
    "qtGotchas": [
      "QML hex colors are #AARRGGBB (alpha FIRST). CSS rgba() strings here are r,g,b 0-255 and a 0-1; convert with Qt.rgba(r/255, g/255, b/255, a).",
      "Hairline separator = 1 device pixel = 1 / devicePixelRatio logical px.",
      "QML SpringAnimation spring/damping params are NOT the same units as the stiffness/damping below. Implement own spring or tune by eye.",
      "SF Pro / SF Symbols are Apple-licensed fonts/assets. Use the fallback font and an open icon set (Lucide, Phosphor). Check Apple's license terms yourself."
    ]
  },

